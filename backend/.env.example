APP_NAME="Booking System API"
# Set to "production" on the server: the app then refuses to start with default secrets.
APP_ENV="development"
DATABASE_URL="postgresql+psycopg://booking_user:booking_password@localhost:5432/booking_db"
TEST_DATABASE_URL="postgresql+psycopg://booking_user:booking_password@localhost:5432/booking_test_db"
TEST_DATABASE_ADMIN_URL="postgresql+psycopg://localhost/postgres"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-gmail-address@gmail.com"
SMTP_PASSWORD="YOUR_APP_PASSWORD"
SMTP_FROM_EMAIL="your-gmail-address@gmail.com"
SMTP_USE_TLS=true

# Production (Render blocks SMTP): emails go through Brevo's HTTPS API when this
# is set, using SMTP_FROM_EMAIL as the sender. Leave empty locally to use SMTP.
BREVO_API_KEY=""
# Where customer replies go (defaults to SMTP_FROM_EMAIL).
EMAIL_REPLY_TO=""

# Mailpit fallback (commented out)
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_FROM_EMAIL="no-reply@northstreetstudio.se"
# SMTP_USE_TLS=false

SHOP_NAME="North Street Studio"
SHOP_ADDRESS="27 North Street, Gothenburg"

# Frontend URLs allowed to call the API (comma-separated, no trailing slash).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# The website's address, used for links in emails ("manage your booking").
PUBLIC_SITE_URL="http://localhost:5173"
# Customers can cancel online until this many hours before the appointment.
CUSTOMER_CANCEL_CUTOFF_HOURS=2
